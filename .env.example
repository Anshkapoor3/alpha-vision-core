# ---------------------------------------------------------------------------
# Contact form — SERVER ONLY.
# These variables hold secrets/credentials and MUST be configured as
# server-only environment variables (e.g. in Vercel Project Settings).
# They are read via process.env inside src/server/* and are never inlined
# into the client bundle. Never prefix them with VITE_.
# ---------------------------------------------------------------------------

# Transactional email provider API key (Resend; starts with "re_...").
CONTACT_EMAIL_PROVIDER_KEY=

# Recipient address that receives contact form submissions.
CONTACT_EMAIL_TO=

# Verified sender address used by Resend to send on your behalf.
CONTACT_EMAIL_FROM=

# --- Optional abuse / payload protections (sensible defaults apply if unset) ---

# Maximum accepted request body size in bytes.
CONTACT_MAX_BODY_BYTES=65536

# Maximum submissions allowed per client IP within the rate-limit window.
CONTACT_RATE_LIMIT_MAX=5

# Rate-limit window in milliseconds.
CONTACT_RATE_LIMIT_WINDOW_MS=60000
